useEffect(() => {
    if (!isMFlagsLoaded || childData === null) {
        return;
    }

    // Today → live SSE should handle the data
    if (childData === currentMFlagsDate) {
        console.log("Selected date is TODAY");
        return;
    }

    // Historical date → fetch historical data
    const controller = new AbortController();

    const loadHistoricalData = async () => {
        try {
            const params = new URLSearchParams({
                date: String(childData)
            });

            console.log(
                "Loading historical data:",
                childData
            );

            const response = await fetch(
                `http://localhost:8080/api/date_change?${params.toString()}`,
                {
                    signal: controller.signal
                }
            );

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }

            const json = await response.json();

            console.log(
                "Historical data received:",
                childData
            );

            setDateWiseData(json);

        } catch (error) {

            if (error.name === "AbortError") {
                console.log(
                    "Historical request cancelled:",
                    childData
                );
                return;
            }

            console.error(
                "Historical data error:",
                error
            );

            setDateWiseData(null);
        }
    };

    loadHistoricalData();

    return () => {
        controller.abort();
    };

}, [
    childData,
    currentMFlagsDate,
    isMFlagsLoaded
]);
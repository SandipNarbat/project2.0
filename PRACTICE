function escapeRegex(str) {
  return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

/**
 * Parses a data line like:
 *   "009138 CIF.1.001"       -> { replicaId: "009138", code: "CIF", suffix: null }
 *   "009856 CIF.1.006.A"     -> { replicaId: "009856", code: "CIF", suffix: "A"  }
 */
function parseLine(line) {
  const parts = line.split(/\s+/);
  if (parts.length < 2) return null;

  const [replicaId, identifier] = parts;
  const segments = identifier.split(".");
  if (segments.length < 3) return null;

  const code = segments[0];
  // segments = [code, "1", num]           -> no suffix
  // segments = [code, "1", num, suffix]   -> has suffix
  const suffix = segments.length > 3 ? segments[3] : null;

  return { replicaId, code, suffix };
}

/// Queue Buildup Replica
async function QueueBuildupReplica(fileList, queue) {
  const state = {};
  let totalCount = 0;
  const folderPath = "../portal_data";

  const spacedQueue = queue.includes(" ");
  let wantedCode;
  let wantedSuffix;

  if (spacedQueue) {
    // e.g. "CIFQ A" -> wantedCode = "CIF", wantedSuffix = "A"
    const [codePart, suffixPart] = queue.split(" ");
    wantedCode = codePart.slice(0, -1);
    wantedSuffix = suffixPart;
  } else {
    // e.g. "CIFQ" -> wantedCode = "CIF", wantedSuffix = null (plain, no suffix)
    wantedCode = queue.slice(0, -1);
    wantedSuffix = null;
  }

  // Promise.all resolves its returned array in the same order as fileList,
  // even though the async reads inside finish at different times. So each
  // task below just RETURNS its result instead of writing into `state`
  // directly — writing directly from inside the concurrent callbacks is
  // what caused `state`'s key order to follow read-completion order
  // instead of fileList order.
  const results = await Promise.all(fileList.map(async (file) => {
    const filePath = path.join(folderPath, file);

    const match = file.match(/replica_details_(.*?)_/);
    const identifier = match ? match[1] : file.split('.')[0];
    const stateKey = `${identifier}_${queue}`;

    const content = await fsp.readFile(filePath, "utf8");
    const replicas = [];

    content.split("\n").forEach(line => {
      line = line.trim();
      if (!line) return;

      const parsed = parseLine(line);
      if (!parsed) return;

      const hit = parsed.code === wantedCode && parsed.suffix === wantedSuffix;
      if (hit) {
        replicas.push(parsed.replicaId);
      }
    });

    return { stateKey, replicas };
  }));

  // Apply results sequentially, in fileList order, so `state`'s key
  // order (and therefore the JSON output order) matches fileList order.
  for (const { stateKey, replicas } of results) {
    state[stateKey] = replicas;
    totalCount += replicas.length;
  }

  return state;
}
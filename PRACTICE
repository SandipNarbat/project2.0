# ============================================================================
# WORKER ORDER FOR EVENTS
# ============================================================================


class EventOrderingManager:
    def __init__(self):
        self.job_queues: Dict[Tuple[str, str], queue.Queue] = defaultdict(
            lambda: queue.Queue(maxsize=10)
        )

        self.active_workers = set()
        self.lock = threading.Lock()

    def submit_event(self, event_data: dict, processor_func):
        joid = event_data.get("joid")
        runid = event_data.get("runid")

        if not joid or not runid:
            executor.submit(processor_func, event_data)
            return

        key = (str(runid), str(joid))

        try:
            self.job_queues[key].put((event_data, processor_func), timeout=0.5)
        except queue.Full:
            print(f"WARNING: Event queue full for job {joid}")
            executor.submit(processor_func, event_data)
            return

        with self.lock:
            if key not in self.active_workers:
                self.active_workers.add(key)
                executor.submit(self._job_worker, key)

    def _job_worker(self, job_key: Tuple[str, str]):
        job_queue = self.job_queues[job_key]

        while True:
            try:
                event_data, processor_func = job_queue.get(timeout=0.5)
                processor_func(event_data)

                job_queue.task_done()

            except queue.Empty:
                with self.lock:
                    if job_queue.empty():
                        self.active_workers.discard(job_key)
                        if job_key in self.job_queues:
                            del self.job_queues[job_key]
                        break
            except Exception as e:
                print(f"Error processing event for job {job_key}: {e}")


event_manager = EventOrderingManager()


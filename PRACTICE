const watchdog = setInterval(() => {

    if (closed) return;

    const elapsed =
        Date.now() - lastSSEMessageRef.current;

    if (elapsed > 20000) {

        console.warn(
            "SSE watchdog: backend connection lost"
        );

        setStatus("disconnected");

        if (esRef.current) {
            esRef.current.close();
            esRef.current = null;
        }

        if (!reconnectTimerRef.current) {

            reconnectTimerRef.current = setTimeout(() => {

                reconnectTimerRef.current = null;

                if (!closed) {
                    connect();
                }

            }, 1000);
        }
    }

}, 5000);



return () => {

    closed = true;

    clearInterval(watchdog);

    // your existing cleanup...

};





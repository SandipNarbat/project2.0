# Main bootstrap
# ------------------------------------------------------------------
def main():
    logger.info("Main", "Started monitoring system")
    loaded = load_all_profiles()
    job_profiles.update(loaded)
    logger.info("main", f"Loaded {len(loaded)} job profiles")

    monitor_thread = threading.Thread(target=monitor_baselines, daemon=True)
    monitor_thread.start()

    try:
        run_streamer_forever(CONFIG["log_dir"])
    except KeyboardInterrupt:
        logger.info("Main", "KeyboardInterrupt recieved")
    finally:
        logger.info("Main", "Shutting down")
        print("shutting down the system")
        STOP_EVENT.set()

        for profile in job_profiles.values():
            try:
                save_job_profile(profile)
            except Exception:
                pass

        time.sleep(0.2)
        logger.shutdown
        print("Shutdown Completed!!")


if __name__ == "__main__":
    main()

def handle_stream_output(line_text: str):
    try:
        rec = preprocess_stream_line(line_text)
        if not rec:
            return

        required_fields = ["JOID", "RUNID", "JobName", "Status", "timestamp" , "Machine"]
        missing = [f for f in required_fields if f not in rec]
        if missing:
            return

        event_data = {
            "joid": rec.get("JOID"),
            "runid": rec.get("RUNID"),
            "job_name": rec.get("JobName"),
            "status": rec.get("Status"),
            "timestamp": rec.get("timestamp"),
            "machine": rec.get("Machine"),
        }
        on_log_event(event_data)

    except Exception as e:
        print("StreamHandler", f"Error in handle_stream_output: {str(e)}")


def run_streamer_forever(base_log_dir: str):
    current_date = datetime.now().date()
    current_log_path = build_log_file_path(base_log_dir, datetime.now())

    logger.info("Main", "starting log Streamer", {"log_file": str(current_log_path)})
    while not STOP_EVENT.is_set():
# ----->> for production 
        # streamer = AutosysTailStreamer(current_log_path)
        # try:
        #     streamer.stream(emit=handle_stream_output)

# ----->> for the historical logs 
        streamer = AutosysLogStreamer(log_path=current_log_path, speed=CONFIG["streaming_speed"])
        try:
            streamer.stream(emit=handle_stream_output)

        except KeyboardInterrupt:
            raise
        except Exception as e:
            logger.error("Main", "Streamer error", {"error": str(e)})

        while not STOP_EVENT.is_set():
            now = datetime.now().date()
            if now != current_date:
                current_date = now
                current_log_path = build_log_file_path(base_log_dir, datetime.now())

                logger.info(
                    "Main",
                    "log file rollover detected",
                    {"new_log_file": str(current_log_path)},
                )
                break
            STOP_EVENT.wait(1)


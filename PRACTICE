import React, { useMemo, useState } from "react";

import {
  ResponsiveContainer,
  LineChart,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  Legend,
} from "recharts";

import "./Flow.css";

export default function Flow() {
  // Your existing data structure
  const data = [
    [
      "TIME", "CASQ", "CIFQ", "CIFQ A", "CIFQ I",
      "CIFQ M", "CIRQ", "DEPQ", "DEPQ A", "DEPQ I",
      "DEPQ M", "DP1Q", "DP1Q A", "DP1Q I", "DP1Q M"
    ],
    [
      "06:32:54.297.949",
      "NONE", "0", "0", "0", "NONE",
      "0", "0", "0", "0", "0", "0", "0", "0", "NONE"
    ],
    [
      "06:33:09.860.658",
      "NONE", "0", "0", "0", "NONE",
      "0", "0", "0", "0", "0", "0", "0", "0", "NONE"
    ],
    [
      "11:48:55.618.054",
      "0", "59", "0", "0", "0",
      "0", "42", "0", "0", "0", "0", "0", "0", "0"
    ],
    [
      "11:49:16.161.034",
      "0", "306", "0", "0", "0",
      "0", "177", "0", "0", "0", "0", "0", "0", "0"
    ],
    [
      "11:49:34.462.984",
      "0", "0", "0", "0", "0",
      "0", "233", "0", "0", "0", "0", "0", "0", "0"
    ],
    [
      "12:24:53.529.381",
      "0", "107", "0", "0", "0",
      "0", "97", "0", "0", "0", "0", "0", "0", "0"
    ],
    [
      "12:25:12.287.991",
      "0", "29", "0", "0", "0",
      "0", "168", "0", "0", "0", "0", "0", "0", "0"
    ],
    [
      "12:25:28.883.056",
      "0", "0", "0", "0", "0",
      "0", "112", "0", "0", "0", "0", "0", "0", "0"
    ],
  ];

  const [hiddenQueues, setHiddenQueues] = useState([]);

  // Convert your 2D array into objects for Recharts
  const { chartData, queueNames } = useMemo(() => {
    const headers = data[0].map((header) => header.trim());

    const rows = data.slice(1).map((row) => {
      const item = {};

      headers.forEach((header, index) => {
        const value = row[index]?.toString().trim();

        if (header === "TIME") {
          item.time = value;
        } else {
          const number = Number(value);

          item[header] =
            value === "" || value === "NONE" || !Number.isFinite(number)
              ? null
              : number;
        }
      });

      return item;
    });

    return {
      chartData: rows,
      queueNames: headers.filter((header) => header !== "TIME"),
    };
  }, []);

  const toggleQueue = (queue) => {
    setHiddenQueues((previous) =>
      previous.includes(queue)
        ? previous.filter((item) => item !== queue)
        : [...previous, queue]
    );
  };

  return (
    <div className="flow-dashboard">
      <div className="flow-header">
        <div>
          <h2>Queue Buildup Analytics</h2>
          <p>Detailed queue count trends by timestamp</p>
        </div>

        <span className="live-status">
          <span className="status-dot" />
          Monitoring
        </span>
      </div>

      <div className="flow-chart-container">
        <ResponsiveContainer width="100%" height={420}>
          <LineChart
            data={chartData}
            margin={{ top: 15, right: 25, left: 5, bottom: 15 }}
          >
            <CartesianGrid
              stroke="#303744"
              strokeDasharray="3 3"
              vertical={false}
            />

            <XAxis
              dataKey="time"
              stroke="#929bad"
              tick={{ fill: "#aab3c2", fontSize: 11 }}
              tickLine={false}
              axisLine={{ stroke: "#414957" }}
              minTickGap={25}
            />

            <YAxis
              stroke="#929bad"
              tick={{ fill: "#aab3c2", fontSize: 11 }}
              tickLine={false}
              axisLine={false}
              allowDecimals={false}
            />

            <Tooltip
              contentStyle={{
                backgroundColor: "#171d27",
                border: "1px solid #414957",
                borderRadius: "8px",
                color: "#ffffff",
              }}
              labelStyle={{
                color: "#ffffff",
                marginBottom: "8px",
              }}
              formatter={(value, name) => [
                value == null ? "No data" : value,
                name,
              ]}
              labelFormatter={(label) => `Time: ${label}`}
            />

            <Legend
              wrapperStyle={{
                paddingTop: "15px",
                color: "#d5dbe5",
                fontSize: "12px",
              }}
              onClick={(entry) => toggleQueue(entry.dataKey)}
            />

            {queueNames.map((queue, index) => (
              <Line
                key={queue}
                type="monotone"
                dataKey={queue}
                name={queue}
                stroke={`hsl(${(index * 47 + 150) % 360}, 75%, 60%)`}
                strokeWidth={2}
                dot={false}
                activeDot={{ r: 5 }}
                connectNulls={false}
                hide={hiddenQueues.includes(queue)}
                isAnimationActive={false}
              />
            ))}
          </LineChart>
        </ResponsiveContainer>
      </div>
    </div>
  );
}

.flow-dashboard {
  width: 100%;
  padding: 22px;
  background: #11151d;
  border: 1px solid #29313d;
  border-radius: 14px;
  box-sizing: border-box;
  color: #f1f5f9;
  font-family: Arial, sans-serif;
}

.flow-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 24px;
}

.flow-header h2 {
  margin: 0;
  font-size: 20px;
  font-weight: 600;
  color: #f8fafc;
}

.flow-header p {
  margin: 7px 0 0;
  font-size: 13px;
  color: #929bad;
}

.live-status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px;
  border: 1px solid #285c47;
  border-radius: 20px;
  background: #142c24;
  color: #72e6aa;
  font-size: 12px;
  white-space: nowrap;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #38d996;
  box-shadow: 0 0 8px #38d996;
}

.flow-chart-container {
  width: 100%;
  min-width: 0;
  padding-top: 10px;
}

@media (max-width: 600px) {
  .flow-dashboard {
    padding: 14px;
  }

  .flow-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .flow-header h2 {
    font-size: 17px;
  }
}


Vulnerabilities reported in Node.js and PHP:

Node.js has also announced security releases for October 21, with HIGH-severity vulnerabilities affecting its 26.x, 24.x and 22.x release lines.

HIGH severity security releases for 22, 24 and 26, landing today or right after. End-of-life versions get nothing.

Node shipped 10 security fixes today plus the eMudhra CA block.

• A flaw in Node's Brotli compression decoder lets an attacker run code remotely.
• 3 bugs let attackers bypass HTTPS certificate checks (including using Unicode digits to fake IP addresses).
• Single-executable Node apps were saving their random seed at build time, so every run generated the exact same "random" UUIDs.
• Node hardcodes its own list of trusted CAs inside the binary, so updating Linux does not stop Node from trusting the leaked eMudhra keys.

Real-world impact:
Almost every modern web backend, API server, and CLI tool runs on Node. Until you update the Node binary itself, your backend can be tricked into trusting fake HTTPS servers (via eMudhra) or compromised by a crafted compressed request.


The PHP Patch Plot Twist (8.5.12 / 8.4.27 / 8.3.36 / 8.2.35 out now)

What happened:
PHP's official advisory just dropped and revealed how the two bugs actually work:
• Bug 1: Forcing PHP to run out of memory while parsing a request leaves internal memory half-built. When PHP cleans up the failed request, it executes that corrupted memory.
• Bug 2: Crashing Request #1 leaves leftover pointers in the worker process, and Request #2 on that same worker trips over them before the new request even initializes.

Real-world impact:
WordPress, Magento, WooCommerce, and Laravel sites (~75% of the web runs PHP) can be taken over by a single HTTP request before your website's own code or security plugins even wake up.
Wildest temporary fix from PHP's own advisory while you patch: set \`memory_limit = -1\` so attackers can't intentionally trigger the out-of-memory crash.

If you run either stack in production, keep an eye on official advisories and apply patches promptly.  Security maintenance doesn't stop at your application code. Your runtime matters too.




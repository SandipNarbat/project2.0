# build file path function
def build_log_file_path(base_dir: str, date: datetime) -> Path:
    datestr = date.strftime("%m%d%Y")
    # filename = f"event_demon.SBI.{datestr}.txt"
    # filename = f"event_demon.RDR.{datestr}.txt"
    filename = f"event_demon.PDR.{datestr}"


    return Path(base_dir) / filename


def on_log_event(event: dict):

    status = event["status"]
    job_name = event["job_name"]
    joid = event["joid"]
    run_id = event["runid"]
    timestamp = event["timestamp"]
    machine = event["machine"]

    if status == "STARTING":
        expected = handle_start_event(job_name, joid, run_id)
        state_manager.start_job(
            joid=str(joid),
            runid=str(run_id),
            job_name=job_name,
            machine= machine,
            predicted_duration=expected,
            baseline_seconds=expected,
        )
        logger.info(
            "jobStart",
            "job Started",
            {
                "timestamp": timestamp,
                "joid": joid,
                "runid": run_id,
                "job_name": job_name,
                "machine": machine,
                "expected duration": round(expected, 2) if expected else None,
            },
        )

    elif status == "SUCCESS":
        result = handle_success_event(job_name, joid, run_id, machine)
        if result is None:
            return
        duration, expected_duration = result
        ended = state_manager.end_job(str(joid), str(run_id))
        if ended:
            logger.info(
                "jobEnd",
                "job completed Successfully",
                {
                    "timestamp": timestamp,
                    "joid": joid,
                    "runid": run_id,
                    "job_name": job_name,
                    "machine": machine,
                    "expected_duration": (
                        round(expected_duration, 2) if expected_duration else None
                    ),
                    "duration": round(duration, 2) if duration else None,
                },
            )
        if not ended:
            return

    elif status == "FAILURE":
        handle_failure_event(job_name, joid, run_id, machine)
        ended = state_manager.end_job(str(joid), str(run_id))
        if ended:
            logger.warning(
                "jobEnd",
                "job failed",
                {
                    "timestamp": timestamp,
                    "joid": joid,
                    "runid": run_id,
                    "job_name": job_name,
                    "machine": machine,
                },
            )

    elif status == "INACTIVE":
        handle_inactive_event(job_name, joid, run_id, machine)
        ended = state_manager.end_job(str(joid), str(run_id))
        if ended:
            logger.warning(
                "jobEnd",
                "job become inactive",
                {
                    "timestamp": timestamp,
                    "joid": joid,
                    "runid": run_id,
                    "job_name": job_name,
                    "machine": machine,
                },
            )
    else:
        return


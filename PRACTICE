def monitor_baselines():
    logger.info("BaselineMonitor", "Baseline monitoring thread started")

    while not STOP_EVENT.is_set():
        try:
            active_jobs = state_manager.get_active_jobs()

            for job in active_jobs:
                key = (job.runid, job.joid)

                if not job.exceeded_baseline():
                    continue

                if not state_manager.can_alert_for_job(key):
                    continue

                exceeded_info = job.get_exceeded_amount()
                logger.warning(
                    "BaselineMonitor",
                    "Baseline exceeded",
                    {
                        "joid": job.joid,
                        "runid": job.runid,
                        "job_name": job.job_name,
                        "machine": job.machine,
                        "baseline_seconds": round(job.predicted_duration, 2),
                        "current_duration": round(job.duration_so_far(), 2),
                        "exceeded_by": exceeded_info["seconds"],
                        "exceeded_by_percent": f"{exceeded_info['percent']}%",
                    },
                )

                print(
                    f"⚠️ ALERT: {job.job_name} exceeded prediction by {exceeded_info['seconds']}s ({exceeded_info['percent']}%)"
                )

            STOP_EVENT.wait(5)

        except Exception as e:
            logger.error("BaselineMonitor", f"Monitor error: {str(e)}")
            STOP_EVENT.wait(5)
    logger.info("BaselineMonitor", "Baseline monitoring thread stopped")
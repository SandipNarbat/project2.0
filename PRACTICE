@dataclass
class LogEvent:
    timestamp: str
    level: str
    module: str
    message: str
    context: Dict[str, Any] = None

    def to_dict(self):
        return asdict(self)


class AsyncStructuredLogger:

    def current_log_date(self)-> str:
        return date.today().isoformat()
    
    def __init__(self, log_dir: str):
        self.current_date = self.current_log_date()
        self.log_dir = Path(log_dir)
        self.log_dir.mkdir(parents=True, exist_ok=True)
        self.events_log = self.log_dir / f"MonitAI_{self.current_date}.jsonl"
        self.events_txt = self.log_dir / f"MonitAI_{self.current_date}.txt"
        self.log_queue = queue.Queue(maxsize=50000)
        self.stop_logging = threading.Event()
        self.logger_thread = threading.Thread(target=self._log_worker, daemon=True)
        self.logger_thread.start()

        print(f"AsyncStructuredLogger initialized - background thread started")

    def _log_worker(self):
        buffers = {
            "events": [],
            "event_txt": [],
        }

        while not self.stop_logging.is_set() or not self.log_queue.empty():
            new_date = self.current_log_date()
            if new_date != self.current_date:
                self.current_date = new_date
                self.events_log = self.log_dir / f"MonitAI_{new_date}.jsonl"
                self.events_txt = self.log_dir / f"MonitAI_{new_date}.txt"

            try:
                batch = []
                try:
                    batch.append(self.log_queue.get(timeout=0.1))

                    for _ in range(99):
                        try:
                            batch.append(self.log_queue.get_nowait())
                        except queue.Empty:
                            break
                except queue.Empty:
                    continue

                for log_type, data in batch:
                    if log_type == "event":
                        buffers["events"].append(json.dumps(data) + "\n")

                        ts = data["timestamp"]
                        level = data["level"]
                        module = data["module"]
                        message = data["message"]
                        context = data.get("context", {})

                        txt_line = (
                            f"[{ts}] [{level}] [{module}] {message}"
                        )
                        if context:
                            txt_line += f" | {context}"
                        
                        buffers["event_txt"].append(txt_line + "\n")


                if buffers["events"]:
                    with open(self.events_log, "a", encoding="utf-8") as f:
                        f.writelines(buffers["events"])
                    buffers["events"].clear()

                if buffers["event_txt"]:
                    try:
                        with open(self.events_txt, "a", encoding="utf-8") as f:
                            f.writelines(buffers["event_txt"])
                    except Exception as e:
                        print(f"WORNING: failed to write TXT log:{e}")
                    finally:
                        buffers["event_txt"].clear()     

                for _ in batch:
                    self.log_queue.task_done()

            except Exception as e:
                print(f"ERROR in logger thread: {e}")

    def _safe_serialize(self, obj):
        return sanitize_for_json(obj)

    def log_event(
        self, level: str, module: str, message: str, context: Dict[str, Any] = None
    ):
        event = {
            "timestamp": datetime.now().isoformat(),
            "level": level,
            "module": module,
            "message": message,
            "context": self._safe_serialize(context) if context else {},
        }

        try:
            self.log_queue.put_nowait(("event", event))
        except queue.Full:
            print(f"WARNING: Log queue full (10000 items), dropping event: {message}")

    def info(self, module: str, message: str, context: Dict = None):
        self.log_event("INFO", module, message, context)

    def warning(self, module: str, message: str, context: Dict = None):
        self.log_event("WARNING", module, message, context)

    def error(self, module: str, message: str, context: Dict = None):
        self.log_event("ERROR", module, message, context)

    def shutdown(self):
        print("Shutting down logger, waiting for queue to empty...")
        print(f"Queue size: {self.log_queue.qsize()}")
        self.log_queue.join()  # Wait for all logs to be written
        self.stop_logging.set()
        self.logger_thread.join(timeout=10)
        print("Logger shutdown complete")

    def get_queue_size(self):
        return self.log_queue.qsize()


logger = AsyncStructuredLogger(CONFIG["log_dir"])


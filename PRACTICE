@dataclass
class JobInstance:
    """Tracks a running job instance"""

    joid: str
    runid: str
    job_name: str
    machine: str
    start_time: float
    predicted_duration: Optional[float]
    baseline_seconds: Optional[float]
    alerted: bool = False
    last_alert_time: Optional[float] = None

    def duration_so_far(self) -> float:
        return time.monotonic() - self.start_time

    def exceeded_baseline(self) -> bool:
        ABSOLUTE_GRACE_SECONDS = 30.0
        RELATIVE_GRACE_FACTOR = 1.20
        expected = self.predicted_duration
        if not expected or expected <= 0:
            return False
        
        if expected < 30:
            return False

        current = self.duration_so_far()
        return (
            current >= expected + ABSOLUTE_GRACE_SECONDS
            and current >= expected * RELATIVE_GRACE_FACTOR
        )

    def get_exceeded_amount(self) -> Dict[str, float]:
        if not self.predicted_duration or self.predicted_duration <= 0:
            return {"seconds": 0, "percent": 0}
        exceeded = max(0, self.duration_so_far() - self.predicted_duration)
        return {
            "seconds": round(exceeded, 2),
            "percent": round((exceeded / self.predicted_duration) * 100, 2),
        }


class StateManager:

    def __init__(self, alert_cooldown: int = 300):
        self.running_jobs: Dict[Tuple[str, str], JobInstance] = {}
        self.lock = threading.Lock()
        self.alert_cooldown = alert_cooldown

    def start_job(
        self,
        joid: str,
        runid: str,
        job_name: str,
        machine: str,
        predicted_duration: float,
        baseline_seconds: Optional[float],
    ):
        key = (runid, joid)
        with self.lock:

            if not joid or not runid:
                logger.warning(
                    "StateManager",
                    "Invalid job identifiers",
                    {"joid": joid, "runid": runid},
                )
                return

            self.running_jobs[key] = JobInstance(
                joid=str(joid),
                runid=str(runid),
                job_name=str(job_name),
                machine=str(machine),
                start_time=time.monotonic(),
                predicted_duration=(
                    float(predicted_duration) if predicted_duration else 0.0
                ),
                baseline_seconds=float(baseline_seconds) if baseline_seconds else None,
            )

    def end_job(self, joid: str, runid: str) -> Optional[JobInstance]:
        key = (runid, joid)
        with self.lock:
            return self.running_jobs.pop(key, None)

    def get_active_jobs(self) -> list:
        with self.lock:
            return list(self.running_jobs.values())

    def can_alert_for_job(self, key: Tuple[str, str]) -> bool:
        with self.lock:
            job = self.running_jobs.get(key)
            if not job:
                return False

            now_mono = time.monotonic()

            if job.alerted and job.last_alert_time:
                if (now_mono - job.last_alert_time) < self.alert_cooldown:
                    return False

            job.alerted = True
            job.last_alert_time = now_mono
            return True


# Global state
